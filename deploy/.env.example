# Скопируйте в .env (в git не попадает) и задайте значения
PODGON_DB_PASSWORD=change_me

# Секреты входа (обязательны вне локальной разработки; значения compose по умолчанию — только для dev)
# openssl rand -base64 48
PODGON_CODE_HMAC_SECRET=change_me_min_32_chars
# Ключ подписи JWT, Base64 от ≥ 32 случайных байт (openssl rand -base64 48); при ротации добавить PODGON_AUTH_JWTKEYS_K2 и сменить PODGON_AUTH_JWTACTIVEKID
PODGON_AUTH_JWTKEYS_K1=change_me_base64
