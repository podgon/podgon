<?xml version="1.0" encoding="utf-8"?>
<!-- Токены и данные приложения не попадают ни в облачный бэкап, ни при переносе на другое устройство -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
