root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
max_line_length = 120

[Makefile]
indent_style = tab

# Compose: функции-компоненты именуются с заглавной буквы
[*.kt]
ktlint_function_naming_ignore_when_annotated_with = Composable

# Сгенерированный код (например, ресурсы Compose) линтером не проверяется
[**/build/generated/**/*.kt]
ktlint = disabled
